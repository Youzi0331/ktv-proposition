# 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# 服务器端口
PORT=3000

# JWT 密钥（生产环境请使用强随机字符串）
JWT_SECRET=your-secret-key-change-this-in-production

# 运行环境
NODE_ENV=development

# PostgreSQL 数据库连接（Vercel 部署必需）
# 从 Supabase 获取连接字符串
# 格式：postgresql://postgres.xxxxx:密码@host:5432/postgres
DATABASE_URL=postgresql://user:password@localhost:5432/ktv
